# CUSTOMER_BANK_PREFIX=vastra-cust-

GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_PROVIDER=gmail           # or "resend" once your domain is verified in Resend
EMAIL_FROM_NAME=Vastra Support
RESEND_API_KEY=
RESEND_FROM=support@yourdomain.com
GMAIL_ADDRESS=                 # support inbox: sends mail and reads customer replies (IMAP)
